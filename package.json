    "child_process": "^1.0.2",
    "dotenv": "^16.4.5",
    "dropbox": "^10.34.0",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.49.1",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "@types/axios": "^0.14.0",
    "@types/dotenv": "^8.2.0",
    "electron": "^30.1.0",
